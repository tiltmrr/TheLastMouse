MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1750086363}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2110e5ca27f4fb43a683f6046a095d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: 
  portrait: {fileID: 0}
  dialogueLines:
  - speakerName: "\u042D\u0434\u0433\u0430\u0440"
    text: "\u0427\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442?..
      \u0427\u0442\u043E \u0442\u0430\u043C \u0434\u0435\u043B\u0430\u044E\u0442
      \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438, \u0438 \u043A\u0442\u043E
      \u044D\u0442\u043E\u0442 \u043A\u043E\u0442..."
    isPlayer: 1
    bubblePosition: {x: 0, y: -400}
  - speakerName: "\u0427\u0435\u0440\u043D\u044B\u0439 \u041A\u043E\u0442"
    text: "\u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0441\u0435\u0439\u0447\u0430\u0441
      \u0436\u0435 \u043E\u0442\u0434\u0430\u0442\u044C \u043D\u0430\u043C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439, \u0438\u043D\u0430\u0447\u0435..."
    isPlayer: 0
    bubblePosition: {x: 400, y: 200}
  - speakerName: "\u0421\u043A\u0430\u0440\u043B\u0435\u0442"
    text: "\u0418 \u043D\u0435 \u043D\u0430\u0434\u0435\u0439\u0442\u0435\u0441\u044C..!"
    isPlayer: 0
    bubblePosition: {x: -400, y: 200}
  - speakerName: "\u0425\u0430\u0440\u0440\u0438\u0441\u043E\u043D"
    text: "\u0412\u044B \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      \u0438\u0445, \u0442\u0435\u043C \u0431\u043E\u043B\u0435\u0435 \u043F\u0443\u0442\u0435\u043C
      \u0432\u0440\u0430\u0436\u0434\u044B!"
    isPlayer: 0
    bubblePosition: {x: -300, y: 100}
  - speakerName: "\u0427\u0435\u0440\u043D\u044B\u0439 \u041A\u043E\u0442"
    text: "\u0427\u0442\u043E \u0436... \u0422\u043E\u0433\u0434\u0430 \u0432\u044B
      \u043F\u043E\u0439\u0434\u0451\u0442\u0435 \u0441 \u043D\u0430\u043C\u0438,
      \u0440\u0430\u043D\u043E \u0438\u043B\u0438 \u043F\u043E\u0437\u0434\u043D\u043E
      \u0432\u044B \u0441\u0434\u0430\u0434\u0438\u0442\u0435\u0441\u044C!"
    isPlayer: 0
    bubblePosition: {x: 400, y: 200}
  - speakerName: "\u042D\u0434\u0433\u0430\u0440"
    text: "\u041C\u0430\u043C\u0430! \u041F\u0430\u043F\u0430! \u041D\u0435\u0442..."
    isPlayer: 1
    bubblePosition: {x: 0, y: -400}
  oneTime: 1
  saveKey: window_cutscene
